# ==============================================================================
# Infoboard v4 - Configuration Template
# All variables are optional with sensible defaults.
# Modern NUXT_* variables are recommended. Legacy variable names are also supported.
# ==============================================================================

# --- Display & Kiosk Behavior ---
NUXT_APP_MAGIC_MIRROR=false            # Set to true for pure black & white high-contrast display
NUXT_APP_LOW_POWER_MODE=false          # Set to true to disable blur effects on low-RAM Raspberry Pi
NUXT_APP_TIME_FORMAT="HH:mm:ss"        # Day.js time format (e.g. "HH:mm" or "hh:mm A")
NUXT_APP_DATE_FORMAT="dddd, Do MMMM YYYY" # Day.js date format
NUXT_APP_NAV_BUTTONS=true              # Show action bar (fullscreen, next, exif, mute)
NUXT_APP_SHOW_EXIF=true                # Enable EXIF photo metadata button
NUXT_APP_AUTO_EXPAND_WEATHER=false     # Automatically expand detailed microclimate metrics
NUXT_APP_AUTO_EXPAND_FORECAST=false    # Automatically expand 7-day forecast cards
NUXT_APP_AUTO_EXPAND_TRANSIT=false     # Automatically expand TfL bus arrivals and rail status
NUXT_APP_AUTO_EXPAND_CALENDAR=false    # Automatically expand calendar agenda

# --- Weather (Tomorrow.io API v4) ---
NUXT_WEATHER_ENABLED=true
NUXT_WEATHER_API_KEY=""                # Get free key at https://app.tomorrow.io/
NUXT_WEATHER_LATITUDE=51.5074
NUXT_WEATHER_LONGITUDE=-0.1278
NUXT_WEATHER_LOCATION_NAME="London, UK"
NUXT_WEATHER_UNITS="metric"            # 'metric' (°C, m/s, hPa) or 'imperial' (°F, mph, inHg)
NUXT_WEATHER_ROUND_TEMP=true           # Round temperatures to whole degrees
NUXT_WEATHER_FORECAST_DAYS=7           # Number of forecast days to show (1 to API max, default 7)
NUXT_WEATHER_CACHE_TTL=300             # Upstream API cache retention in seconds (default 5 min)

# --- Transport for London (TfL) ---
NUXT_TRANSIT_ENABLED=true
NUXT_TRANSIT_TFL_APP_ID=""             # Optional: TfL developer app ID
NUXT_TRANSIT_TFL_APP_KEY=""            # Optional: TfL developer app key
# Comma-separated list of TfL StopPoint IDs (e.g. 490013767T,490008660N)
NUXT_TRANSIT_BUS_STOPS=""
# Comma-separated list of rail/transit modes
NUXT_TRANSIT_LINE_MODES="tube,overground,dlr,elizabeth-line,tram"
NUXT_TRANSIT_CACHE_TTL=60              # Upstream transit cache in seconds

# --- Calendar Agenda (iCal) ---
NUXT_CALENDAR_ENABLED=true
# Private/Public iCal address (e.g. Google Calendar secret iCal URL or Apple iCloud share)
NUXT_CALENDAR_ICAL_URL=""
NUXT_CALENDAR_MAX_EVENTS=10            # Maximum upcoming events to display (within 60-day horizon)
NUXT_CALENDAR_CACHE_TTL=900            # Upstream calendar cache in seconds (15 min)

# --- Background Media ---
# Available sources: [local | single | nasa | unsplash | pexels | flickr]
NUXT_MEDIA_SOURCE="nasa"
NUXT_MEDIA_INTERVAL=60                 # Rotation interval in seconds
NUXT_MEDIA_LOCAL_DIR="/media/photos"   # Absolute directory path for local photos/videos
NUXT_MEDIA_ALLOW_VIDEO=false           # Play MP4 video files in local library
NUXT_MEDIA_VIDEO_MUTED=true            # Start video muted
NUXT_MEDIA_WEATHER_TAGGED=true         # Tag Unsplash/Pexels/Flickr with current weather conditions

# Remote Provider Keys
# Note: NASA source uses science.nasa.gov and requires no API key.
NUXT_MEDIA_UNSPLASH_KEY=""             # Unsplash Access Key
NUXT_MEDIA_PEXELS_KEY=""               # Pexels API Key
NUXT_MEDIA_FLICKR_KEY=""               # Flickr API Key

# --- Hardware Sensors (Raspberry Pi) ---
NUXT_SENSOR_DHT_ENABLED=false          # DHT11 / DHT22 temperature & humidity
NUXT_SENSOR_DHT_TYPE="dht22"           # 'dht11' or 'dht22'
NUXT_SENSOR_DHT_PIN=4                  # BCM GPIO pin number
NUXT_SENSOR_SENSEHAT_ENABLED=false     # Raspberry Pi Sense HAT (temp, humidity, pressure)
NUXT_SENSOR_SDS_ENABLED=false          # Nova SDS011 Air Quality PM2.5/PM10
NUXT_SENSOR_SDS_PORT="/dev/ttyUSB0"    # Serial USB port for SDS011
